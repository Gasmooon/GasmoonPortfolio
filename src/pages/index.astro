<script>
	const sections = Array.from(document.querySelectorAll<HTMLElement>("main > section"));
	const visibility = new Map<HTMLElement, number>();

	sections.forEach((section) => {
		section.classList.add("focusable");
		visibility.set(section, 0);
	});

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				visibility.set(entry.target as HTMLElement, entry.intersectionRatio);
			});

			const focusedSection = sections.reduce<HTMLElement | null>((focused, section) => {
				if (!focused || (visibility.get(section) ?? 0) > (visibility.get(focused) ?? 0)) {
					return section;
				}
				return focused;
			}, null);

			sections.forEach((section) => {
				section.classList.toggle("is-focused", section === focusedSection && (visibility.get(section) ?? 0) > 0);
			});
		},
		{ rootMargin: "-35% 0px -35% 0px", threshold: [0, 0.1, 0.25, 0.5, 0.75, 1] },
	);

	sections.forEach((section) => observer.observe(section));
</script>

<script>
	const avatar = document.querySelector<HTMLButtonElement>(".avatar");

	avatar?.addEventListener("click", () => {
		const wasFlipped = avatar.classList.contains("is-flipped");
		const flipper = avatar.querySelector<HTMLElement>(".avatar-flipper");
		const startAngle = wasFlipped ? 180 : 0;
		const endAngle = wasFlipped ? 0 : 180;

		flipper?.getAnimations().forEach((animation) => animation.cancel());
		const isFlipped = avatar.classList.toggle("is-flipped");
		avatar.setAttribute("aria-pressed", String(isFlipped));
		avatar.setAttribute("aria-label", isFlipped ? "Volver a la foto de perfil" : "Girar el avatar para ver la otra cara");

		if (flipper && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			flipper.animate(
				[
					{ transform: `rotateY(${startAngle}deg) scale(1) translateY(0)` },
					{
						offset: 0.42,
						transform: `rotateY(${startAngle + (endAngle - startAngle) * 0.5}deg) scale(1.3) translateY(-18px)`,
					},
					{
						offset: 0.62,
						transform: `rotateY(${startAngle + (endAngle - startAngle) * 0.72}deg) scale(1.3) translateY(-18px)`,
					},
					{
						offset: 0.9,
						transform: `rotateY(${endAngle}deg) scale(1.04) translateY(-3px)`,
					},
					{
						offset: 0.96,
						transform: `rotateY(${endAngle}deg) scale(0.96) translateY(2px)`,
					},
					{ transform: `rotateY(${endAngle}deg) scale(1) translateY(0)` },
				],
				{ duration: 850, easing: "cubic-bezier(0.2, 0.75, 0.25, 1)" },
			);
		}
	});
</script>

<script>
	const projectCards = Array.from(document.querySelectorAll<HTMLButtonElement>(".project-card"));
	const projectDetail = document.querySelector<HTMLElement>(".project-detail");
	let galleryIndex = 0;
	let selectedProjectIndex = 0;

	const showProject = (index: number, scrollToCard = true, scrollToDetail = false) => {
		if (!projectCards.length || !projectDetail) return;
		selectedProjectIndex = (index + projectCards.length) % projectCards.length;
		const card = projectCards[selectedProjectIndex];
		const title = card.dataset.projectTitle ?? "PROYECTO";
		const description = card.dataset.projectDescription ?? "Añade una descripción para este proyecto.";
		const areas = card.dataset.projectAreas ?? "Añade aquí tu participación.";
		const url = card.dataset.projectUrl ?? "#";

		projectDetail.querySelector(".detail-index")!.textContent = title;
		projectDetail.querySelector(".detail-title")!.textContent = card.querySelector("strong")?.textContent ?? "Nombre del proyecto";
		projectDetail.querySelector(".detail-description")!.textContent = description;
		projectDetail.querySelector(".detail-areas")!.textContent = areas;
		const projectLink = projectDetail.querySelector<HTMLAnchorElement>(".detail-link")!;
		projectLink.href = url;
		projectLink.firstChild!.textContent = `${card.dataset.projectLinkLabel ?? "Ver proyecto"} `;
		const media = projectDetail.querySelector<HTMLElement>(".project-detail-media")!;
		media.style.backgroundColor = card.style.getPropertyValue("--project-color");
		const image = projectDetail.querySelector<HTMLImageElement>(".detail-image")!;
		const placeholder = projectDetail.querySelector<HTMLElement>(".media-placeholder")!;
		const imagePath = card.dataset.projectImage;
		image.hidden = !imagePath;
		placeholder.hidden = Boolean(imagePath);
		if (imagePath) {
			image.src = imagePath;
			image.alt = `Captura de ${title}`;
		} else {
			image.removeAttribute("src");
			image.alt = "";
		}
		const cardArt = card.querySelector<HTMLElement>(".project-card-art");
		if (cardArt && imagePath) cardArt.style.backgroundImage = `url("${imagePath}")`;
		projectDetail.querySelector(".detail-count")!.textContent = `${String(selectedProjectIndex + 1).padStart(2, "0")} / ${String(projectCards.length).padStart(2, "0")}`;
		projectDetail.hidden = false;

		if (scrollToCard) card.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
		if (scrollToDetail) requestAnimationFrame(() => projectDetail.scrollIntoView({ behavior: "smooth", block: "nearest" }));
	};

	projectCards.forEach((card, index) => {
		const imagePath = card.dataset.projectImage;
		const cardArt = card.querySelector<HTMLElement>(".project-card-art");
		if (cardArt && imagePath) cardArt.style.backgroundImage = `url("${imagePath}")`;
		card.addEventListener("click", () => {
			galleryIndex = index;
			showProject(index, false, true);
		});
	});

	document.querySelectorAll<HTMLButtonElement>("[data-gallery-step]").forEach((button) => {
		button.addEventListener("click", () => {
			const step = Number(button.dataset.galleryStep);
			galleryIndex = (galleryIndex + step + projectCards.length) % projectCards.length;
			const nextCard = projectCards[galleryIndex];
			nextCard?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
		});
	});

	document.querySelectorAll<HTMLButtonElement>("[data-detail-step]").forEach((button) => {
		button.addEventListener("click", () => showProject(selectedProjectIndex + Number(button.dataset.detailStep)));
	});

	projectDetail?.querySelector<HTMLButtonElement>(".detail-close")?.addEventListener("click", () => {
		projectDetail.hidden = true;
		projectCards[selectedProjectIndex]?.focus();
	});
</script>

<script>
	const parallaxImages = Array.from(document.querySelectorAll<HTMLImageElement>(".parallax-art img:not(.triskelion-layer)"));
	const triskelionLayers = [
		{ image: document.querySelector<HTMLImageElement>(".triskelion-layer--passive"), degreesPerPixel: 0, minScale: 0.85, maxScale: 0.85, autoDegreesPerFrame: -0.03 },
		{ image: document.querySelector<HTMLImageElement>(".triskelion-layer--dynamic-scale"), degreesPerPixel: 0.007, minScale: 0.85, maxScale: 1.25, autoDegreesPerFrame: 0 },
		{ image: document.querySelector<HTMLImageElement>(".triskelion-layer--deepest"), degreesPerPixel: 0.007, minScale: 0.85, maxScale: 0.85, autoDegreesPerFrame: 0 },
		{ image: document.querySelector<HTMLImageElement>(".triskelion-layer--rear"), degreesPerPixel: -0.007, minScale: 0.85, maxScale: 0.85, autoDegreesPerFrame: 0 },
		{ image: document.querySelector<HTMLImageElement>(".triskelion-layer--back"), degreesPerPixel: 0.1, minScale: 0.85, maxScale: 0.85, autoDegreesPerFrame: 0 },
		{ image: document.querySelector<HTMLImageElement>(".triskelion-layer--front"), degreesPerPixel: 0.12, minScale: 0.85, maxScale: 0.85, autoDegreesPerFrame: 0 },
	];
	let parallaxFrame = false;
	let lastScrollY = window.scrollY;
	let pendingScrollDistance = 0;
	const triskelionRotations = triskelionLayers.map(() => 0);

	if ((parallaxImages.length || triskelionLayers.some(({ image }) => image)) && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const updateParallax = () => {
			const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
			const progress = maxScroll > 0 ? Math.min(Math.max(window.scrollY / maxScroll, 0), 1) : 0;
			parallaxImages.forEach((image) => {
				const imageHeight = image.getBoundingClientRect().height;
				const lowerLimit = Math.min(0, window.innerHeight - imageHeight);
				const horizontalOffset = image.classList.contains("triskelion-background") ? "-50%" : "0";
				image.style.transform = `translate3d(${horizontalOffset}, ${lowerLimit * progress}px, 0)`;
			});
			triskelionLayers.forEach(({ image, degreesPerPixel, minScale, maxScale }, index) => {
				triskelionRotations[index] += pendingScrollDistance * degreesPerPixel;
				if (image) {
					const scale = minScale + (maxScale - minScale) * progress;
					image.style.transform = `translate3d(-50%, -50%, 0) rotate(${triskelionRotations[index]}deg) scale(${scale})`;
				}
			});
			pendingScrollDistance = 0;
		};

		const scheduleParallax = (scrollChanged = false) => {
			if (scrollChanged) {
				const currentScrollY = window.scrollY;
				pendingScrollDistance += Math.abs(currentScrollY - lastScrollY);
				lastScrollY = currentScrollY;
			}
			if (parallaxFrame) return;
			parallaxFrame = true;
			window.requestAnimationFrame(() => {
				updateParallax();
				parallaxFrame = false;
			});
		};

		window.addEventListener("scroll", () => scheduleParallax(true), { passive: true });
		window.addEventListener("resize", scheduleParallax);
		parallaxImages.forEach((image) => image.addEventListener("load", scheduleParallax, { once: true }));
		triskelionLayers.forEach(({ image }) => image?.addEventListener("load", scheduleParallax, { once: true }));
		scheduleParallax();

		const passiveLayerIndex = triskelionLayers.findIndex(({ autoDegreesPerFrame }) => autoDegreesPerFrame !== 0);
		if (passiveLayerIndex >= 0) {
			let previousFrameTime: number | null = null;
			const rotatePassiveLayer = (timestamp: number) => {
				const layer = triskelionLayers[passiveLayerIndex];
				if (previousFrameTime !== null && layer.image) {
					const elapsedFrames = Math.min(timestamp - previousFrameTime, 50) / (1000 / 60);
					triskelionRotations[passiveLayerIndex] += layer.autoDegreesPerFrame * elapsedFrames;
					layer.image.style.transform = `translate3d(-50%, -50%, 0) rotate(${triskelionRotations[passiveLayerIndex]}deg) scale(${layer.minScale})`;
				}
				previousFrameTime = timestamp;
				window.requestAnimationFrame(rotatePassiveLayer);
			};
			window.requestAnimationFrame(rotatePassiveLayer);
		}
	}
</script>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		scroll-padding-top: 90px;
	}

	:global(body) {
		position: relative;
		isolation: isolate;
		margin: 0;
		background: #08070d;
		color: #f0edf5;
		font-family: Inter, "Segoe UI", sans-serif;
		overflow-x: hidden;
	}

	:global(body)::before {
		content: "";
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background-image: linear-gradient(#ffffff05 1px, transparent 1px),
			linear-gradient(90deg, #ffffff05 1px, transparent 1px);
		background-size: 72px 72px;
		mask-image: linear-gradient(to bottom, black, transparent 75%);
	}

	.background-glow {
		position: absolute;
		top: 60px;
		left: 50%;
		width: 700px;
		height: 600px;
		transform: translateX(-50%);
		background: radial-gradient(ellipse, #522c7a24 0%, #17102012 45%, transparent 72%);
		pointer-events: none;
		z-index: -1;
	}

	.parallax-art {
		position: fixed;
		inset: 0;
		z-index: -2;
		overflow: hidden;
		pointer-events: none;
	}

	.parallax-art img {
		position: absolute;
		top: 0;
		right: -3vw;
		width: 80vw;
		height: auto;
		opacity: 1;
		filter: drop-shadow(0 0 26px #2528ff88);
		will-change: transform;
	}

	.parallax-art img.triskelion-background {
		top: 0;
		right: auto;
		left: 50%;
		width: max(110vw, 93.87vh);
		max-width: none;
		opacity: 0.75;
		filter: none;
		z-index: -5;
	}

	.parallax-art img.triskelion-layer {
		top: 50%;
		right: auto;
		left: 3vw;
		width: min(80vw, 980px);
		opacity: 0.85;
		transform: translate3d(-50%, -50%, 0) scale(0.85);
		filter: drop-shadow(0 0 32px #542bffbb) drop-shadow(0 0 64px #a020ff66);
		transform-origin: center;
	}

	.parallax-art img.triskelion-layer--back {
		z-index: 0;
	}

	.parallax-art img.triskelion-layer--rear {
		z-index: -1;
	}

	.parallax-art img.triskelion-layer--deepest {
		z-index: -2;
	}

	.parallax-art img.triskelion-layer--dynamic-scale {
		z-index: -3;
	}

	.parallax-art img.triskelion-layer--passive {
		z-index: -4;
	}

	.parallax-art img.triskelion-layer--front {
		z-index: 1;
	}

	a {
