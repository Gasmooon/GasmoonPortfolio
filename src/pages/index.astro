	.about {
		border: 1px solid #c58affc9;
		background: linear-gradient(135deg, #1b102980, #0c091380 58%, #130d1d80);
		box-shadow: 0 0 0 1px #e6caff30 inset, 0 0 10px #b45cff70,
			0 0 28px #9d4dff55, 0 0 58px #7429d52e,
			0 18px 55px #00000066;
		backdrop-filter: blur(14px);
	}

	.focusable {
		opacity: 1;
		transform: scale(0.92);
		border-color: #c58aff70;
		background: linear-gradient(135deg, #1b10294d, #0c09134d 58%, #130d1d4d);
		box-shadow: 0 0 0 1px #e6caff18 inset, 0 0 6px #b45cff35,
			0 0 18px #9d4dff28, 0 0 40px #7429d518,
			0 18px 55px #00000055;
		transition: transform 550ms ease, box-shadow 550ms ease, background 550ms ease, border-color 550ms ease;
	}

	.focusable.is-focused {
		opacity: 1;
		transform: scale(1.02);
		border-color: #c58affc9;
		background: linear-gradient(135deg, #1b102994, #0c091394 58%, #130d1d94);
		box-shadow: 0 0 0 1px #e6caff30 inset, 0 0 10px #b45cff70,
			0 0 28px #9d4dff55, 0 0 58px #7429d52e,
			0 18px 55px #00000066;
	}

