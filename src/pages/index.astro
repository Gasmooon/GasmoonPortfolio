	.projects::before,
	.about::before {
		content: "";
		position: absolute;
		top: 0;
		left: 24px;
		width: 64px;
		height: 2px;
		background: #e4c5ff;
		box-shadow: 0 0 8px #e4c5ff, 0 0 20px #bd73ff, 0 0 34px #8e3eff;
