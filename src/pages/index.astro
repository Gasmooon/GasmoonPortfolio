	nav {
		display: flex;
		align-items: center;
		gap: 24px;
		font-size: 16px;
		color: #d3cbdc;
	}

	.language-switch {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: #9c8eab;
		font-size: 12px;
		letter-spacing: 1px;
	}

	.language-option {
		padding: 7px 5px;
		border: 0;
		background: transparent;
		color: #aaa0b6;
		font: inherit;
		letter-spacing: inherit;
		cursor: pointer;
		transition: color 180ms ease, text-shadow 180ms ease;
	}

	.language-option:hover,
	.language-option.is-active {
		color: #e8d5ff;
		text-shadow: 0 0 10px #b78be899;
	}

	.language-option:focus-visible {
		outline: 1px solid #b78be8;
		outline-offset: 3px;
	}

	.theme-toggle {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 7px 5px;
		border: 0;
		background: transparent;
		color: #c7b8d4;
		cursor: pointer;
	}

	.theme-icon {
		font-size: 13px;
		line-height: 1;
	}

	.theme-toggle-track {
		position: relative;
		width: 34px;
		height: 18px;
		border: 1px solid #a77bd988;
		border-radius: 999px;
		background: #7b4ca52e;
		box-shadow: inset 0 0 8px #9d4dff1c;
		transition: background 180ms ease, border-color 180ms ease;
	}

	.theme-toggle-thumb {
		position: absolute;
		top: 2px;
		left: 2px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #d9b8ff;
		box-shadow: 0 0 8px #b78be8aa;
		transition: transform 180ms ease, background 180ms ease;
	}

	.theme-toggle[aria-checked="true"] .theme-toggle-track {
		border-color: #ffc45e;
		background: #e58b263d;
	}

	.theme-toggle[aria-checked="true"] .theme-toggle-thumb {
		transform: translateX(16px);
		background: #ffe09a;
		box-shadow: 0 0 8px #ffc45eaa;
	}

	.theme-toggle:focus-visible {
		outline: 1px solid #b78be8;
		outline-offset: 3px;
		border-radius: 3px;
	}

	nav a,
	.primary-button {
		transition: color 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease, transform 180ms ease, scale 180ms ease;
	}

	nav a:hover {
		color: #d9b8ff;
	}

	.nav-section-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 8px 22px;
		border: 1px solid #a77bd988;
		border-radius: 3px;
		background: #7b4ca52e;
		color: #efe3fa;
		letter-spacing: 0.5px;
		box-shadow: 0 0 10px #9d4dff1c;
	}

	.nav-section-link:hover {
		border-color: #d1a9f8;
		background: #9b67c844;
		box-shadow: 0 0 16px #9d4dff55;
		transform: translateY(-1px);
	}

	.hero {
		position: relative;
		min-height: 690px;
		max-width: 1150px;
		width: calc(100% - 12%);
		margin: 42px auto;
		padding: 105px 9% 100px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		border: 0;
		background: transparent;
		box-shadow: 0 0 28px #9d4dff25, 0 18px 55px #00000077;
		backdrop-filter: blur(14px);
		transition: transform 550ms ease, box-shadow 550ms ease, border-color 550ms ease, filter 550ms ease;
	}

	.projects,
	.about {
		border: 1px solid #c58affc9;
		background: linear-gradient(135deg, #1b102980, #0c091380 58%, #130d1d80);
		box-shadow: 0 0 0 1px #e6caff30 inset, 0 0 10px #b45cff70,
			0 0 28px #9d4dff55, 0 0 58px #7429d52e,
			0 18px 55px #00000066;
		backdrop-filter: blur(14px);
	}

	.focusable {
		opacity: 1;
		transform: scale(0.92);
		border-color: #c58aff70;
		background: linear-gradient(135deg, #1b10294d, #0c09134d 58%, #130d1d4d);
		box-shadow: 0 0 0 1px #e6caff18 inset, 0 0 6px #b45cff35,
			0 0 18px #9d4dff28, 0 0 40px #7429d518,
			0 18px 55px #00000055;
		transition: transform 550ms ease, box-shadow 550ms ease, background 550ms ease, border-color 550ms ease;
	}

	.focusable.is-focused {
		opacity: 1;
		transform: scale(1.02);
		border-color: #c58affc9;
		background: linear-gradient(135deg, #1b102994, #0c091394 58%, #130d1d94);
		box-shadow: 0 0 0 1px #e6caff30 inset, 0 0 10px #b45cff70,
			0 0 28px #9d4dff55, 0 0 58px #7429d52e,
			0 18px 55px #00000066;
	}
	.hero::before,
	.projects::before,
	.about::before {
		content: "";
		position: absolute;
		top: 0;
		left: 24px;
		width: 64px;
		height: 2px;
		background: #e4c5ff;
		box-shadow: 0 0 8px #e4c5ff, 0 0 20px #bd73ff, 0 0 34px #8e3eff;
	}


	.projects,
	.about {
		position: relative;
		max-width: 1150px;
		width: calc(100% - 12%);
		margin: 32px auto;
		padding: 72px 9%;
		border-top: 1px solid #c58affc9;
		border-radius: 4px;
	}

	.hero.focusable {
		background: transparent;
	}

	.hero.focusable.is-focused,
	.hero:hover {
		transform: scale(1.02);
		background: transparent;
		filter: drop-shadow(0 0 15px #bd73ff55);
		box-shadow: 0 0 38px #9d4dff45, 0 24px 65px #00000099;
	}

	.eyebrow {
		color: #b99ad9;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 3px;
	}

	.hero .eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.hero .eyebrow span {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #c29ae8;
		box-shadow: 0 0 12px #a66be8;
	}

	.hero-identity {
		display: flex;
		align-items: center;
		gap: clamp(24px, 5vw, 68px);
	}

	.avatar {
		width: clamp(130px, 19.5vw, 205px);
		aspect-ratio: 1;
		flex: 0 0 auto;
		padding: 0;
		border: 1px solid #dbb8ff;
		border-radius: 50%;
		background: transparent;
		box-shadow: 0 0 12px #bd73ff99, 0 0 32px #8e3eff66;
		cursor: pointer;
		perspective: 800px;
	}

	.avatar:focus-visible {
		outline: 2px solid #f0d9ff;
		outline-offset: 6px;
	}

	.avatar-flipper {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		border-radius: inherit;
		transform-style: preserve-3d;
		transition: transform 700ms cubic-bezier(0.2, 0.75, 0.25, 1);
	}

	.avatar.is-flipped .avatar-flipper {
		transform: rotateY(180deg);
	}

	.avatar-face {
		position: absolute;
		inset: 0;
		border: 3px solid #110b19;
		border-radius: inherit;
		backface-visibility: hidden;
	}

	.avatar-front {
		background: #8e45cf url("/loyd.jpg") center / cover no-repeat;
	}

	.avatar-back {
		background: #31a4a5 url("/fotoMia.jpeg") center / cover no-repeat;
		transform: rotateY(180deg);
	}

	h1 {
		margin: 28px 0 18px;
		font-size: clamp(58px, 9.5vw, 124px);
		line-height: 0.88;
		letter-spacing: -5px;
		font-weight: 850;
	}

	h1 span {
		color: transparent;
		-webkit-text-stroke: 1px #c9b5dc;
	}

	.role {
		color: #d7cce4;
		font-size: 12px;
		letter-spacing: 3px;
	}

	.role span {
		color: #a978d8;
		margin: 0 7px;
	}

	.intro {
		max-width: 440px;
		margin: 22px 0 30px;
		color: #c4bdca;
		font-size: 14px;
		line-height: 1.9;
	}

.hero-invitation {
		margin: -12px 0 22px;
		color: #d7cce4;
		font-size: 13px;
		line-height: 1.6;
	}

	.primary-button {
		display: inline-flex;
		align-items: center;
		gap: 32px;
		padding: 14px 18px;
		border: 1px solid #a77bd9;
		background: #7b4ca51c;
		font-size: 12px;
	}

	.primary-button:hover {
		background: #9b67c82e;
		border-color: #d1a9f8;
	}

	.primary-button span {
		color: #cda7f4;
	}

	.hero-footer {
		display: flex;
		justify-content: space-between;
		gap: 20px;
		width: 100%;
		margin-top: auto;
		padding-top: 40px;
		color: #aea5b8;
		font-size: 11px;
		letter-spacing: 1.5px;
	}

	.separator {
		color: #a978d8;
		padding: 0 7px;
	}

	.section-heading {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 24px;
		margin-bottom: 35px;
	}

	.section-heading h2,
	.about h2 {
		margin: 12px 0 0;
		font-size: clamp(38px, 5vw, 58px);
		letter-spacing: -2px;
	}

	.section-heading > p {
		color: #b9afc2;
		font-size: 12px;
	}

	.project-gallery-controls,
	.project-gallery-controls > div,
	.project-card-meta,
	.project-detail-topbar,
	.project-detail-navigation {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.project-gallery-controls {
		margin: 0 0 14px;
	}

	.gallery-hint,
	.project-card-meta,
	.detail-index,
	.detail-label {
		color: #c4a5d9;
		font-size: 11px;
		letter-spacing: 1.8px;
	}

	.gallery-hint span {
		color: #d6b3fb;
		font-size: 14px;
		margin-left: 8px;
	}

	.project-gallery-controls > div {
		gap: 8px;
	}

	.gallery-arrow,
	.detail-close,
	.detail-step {
		color: #e5d7f2;
		border: 1px solid #a66be877;
		background: #150e20;
		cursor: pointer;
		transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
	}

	.gallery-arrow {
		width: 34px;
		height: 34px;
		font-size: 16px;
	}

	.gallery-arrow:hover,
	.detail-close:hover,
	.detail-step:hover {
		background: #713e9d66;
		border-color: #d4a5ff;
		color: #fff;
	}

	.project-track {
		display: grid;
		grid-auto-columns: minmax(220px, 27%);
		grid-auto-flow: column;
		gap: 18px;
		overflow-x: auto;
		overflow-y: hidden;
		padding: 8px 4px 20px;
		scroll-snap-type: x mandatory;
		scrollbar-color: #8e55b8 #17101f;
		scrollbar-width: thin;
	}

	.project-card {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 13px;
		padding: 14px;
		color: #eee6f5;
		text-align: left;
		border: 1px solid #ac7bd755;
		background: linear-gradient(145deg, #1a122480, #0e0a1480);
		opacity: 0.62;
		transform: scale(0.965);
		scroll-snap-align: center;
		cursor: pointer;
		transition: opacity 350ms ease, transform 350ms ease, border-color 350ms ease, box-shadow 350ms ease;
	}

	.project-card:hover {
		opacity: 1;
		transform: scale(1.035);
		border-color: #c58aff;
		box-shadow: 0 0 18px #9d4dff55, 0 0 34px #7429d52b;
	}

	.project-card:focus-visible,
	.gallery-arrow:focus-visible,
	.detail-close:focus-visible,
	.detail-step:focus-visible {
		outline: 2px solid #e4c5ff;
		outline-offset: 3px;
	}

	.project-card-art {
		width: 100%;
		aspect-ratio: 1;
		background: var(--project-color, #54277b);
		background-position: center;
		background-size: cover;
		box-shadow: 0 0 20px #00000022 inset;
	}

	.project-card-meta {
		width: 100%;
		font-size: 10px;
	}

	.project-card-meta span:last-child {
		font-size: 14px;
		color: #d1a9f8;
	}

	.project-card strong {
		font-size: 15px;
		font-weight: 500;
	}

	.project-card-note {
		color: #b2a8ba;
		font-size: 12px;
	}

	.project-detail {
		position: fixed;
		inset: 0;
		width: min(1000px, calc(100vw - 32px));
		max-height: min(90vh, 900px);
		max-height: min(90dvh, 900px);
		margin: auto;
		overflow-y: auto;
		padding: 22px;
		border: 1px solid #c58aff99;
		border-radius: 4px;
		background: linear-gradient(135deg, #1b102980, #0c091380 65%, #130d1d80);
		color: #eee6f5;
		box-shadow: 0 0 24px #9d4dff3b, 0 0 48px #7429d522;
		animation: detail-appear 360ms ease both;
	}

	.project-detail::backdrop {
		background: #05030bd9;
	}

	.project-detail-topbar {
		padding-bottom: 14px;
		border-bottom: 1px solid #ffffff16;
	}

	.detail-close {
		width: 32px;
		height: 32px;
		font-size: 22px;
		line-height: 1;
	}

	.project-detail-content {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(24px, 5vw, 58px);
		padding: 24px 0;
	}

	.project-detail-media {
			position: relative;
			overflow: hidden;
			min-height: 200px;
			aspect-ratio: 16 / 10;
		}

	.detail-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.detail-image[hidden],
	.media-placeholder[hidden] {
		display: none;
	}

	.media-placeholder {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
	}

	

	.project-detail-media span {
		font-size: 13px;
		letter-spacing: 2px;
	}

	.project-detail-media small {
		color: #e5d4f0;
		font-size: 12px;
	}

	.project-detail-copy .eyebrow {
		margin-top: 0;
	}

	.detail-title {
		margin: 12px 0;
		font-size: clamp(24px, 3vw, 38px);
		font-weight: 500;
	}

	.detail-description,
	.detail-areas {
		color: #d0c8d6;
		font-size: 13px;
		line-height: 1.8;
	}

	.detail-label {
		margin: 22px 0 4px;
	}

	.detail-areas {
		margin-top: 5px;
	}

	.detail-link {
		display: inline-flex;
		align-items: center;
		gap: 28px;
		margin-top: 12px;
		padding: 11px 14px;
		border: 1px solid #a77bd9;
		background: #7b4ca51c;
		font-size: 11px;
	}

	.detail-link span {
		color: #d1a9f8;
	}

	.project-detail-navigation {
		padding-top: 14px;
		border-top: 1px solid #ffffff16;
	}

	.detail-step {
		padding: 9px 12px;
		font-size: 12px;
	}

	.detail-count {
		color: #b7a7c2;
		font-size: 11px;
		letter-spacing: 1.5px;
	}

	@keyframes detail-appear {
		from { opacity: 0; transform: translateY(12px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.about {
		max-width: 1150px;
	}

	.about-heading {
		margin-bottom: 36px;
	}

	.about-heading .eyebrow {
		margin: 0;
	}

	.about-heading h2 {
		margin-top: 12px;
		line-height: 1.2;
	}

	.about h2 span {
		color: #c1accf;
	}

	.about-layout {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		align-items: start;
		gap: clamp(28px, 5vw, 64px);
	}

	.about-profile h3,
	.about-card-heading h3 {
		margin: 0;
		color: #f0e8fa;
		font-size: 20px;
		font-weight: 550;
	}

	.about-profile > p:not(.signature) {
		max-width: 440px;
		color: #c4bdca;
		font-size: 14px;
		line-height: 1.9;
	}

	.signature {
		margin-top: 28px;
		font-size: 13px;
	}

	.signature span {
		color: #b3a4be;
	}

	.about-details {
		display: grid;
		gap: 16px;
	}

	.about-card {
		padding: 20px;
		border: 1px solid #c58aff70;
		background: #0c09134d;
		box-shadow: 0 0 18px #9d4dff1e inset, 0 0 18px #7429d51a;
	}

	.about-card-heading {
		margin-bottom: 16px;
	}

	.about-card-heading .eyebrow {
		margin: 0 0 8px;
		letter-spacing: 2px;
	}

	.skill-groups {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.skill-group {
		min-width: 0;
		padding: 12px;
		border-left: 2px solid #b978e8;
		background: #180f235c;
	}

	.skill-group h4 {
		margin: 0 0 10px;
		color: #dfc6f4;
		font-size: 13px;
		font-weight: 600;
	}

	.skill-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
	}

	.skill-tags span {
		padding: 6px 8px;
		border: 1px solid #a77bd955;
		background: #7b4ca51c;
		color: #d7cce4;
		font-size: 11px;
		line-height: 1.4;
	}

	.about-links {
		grid-column: 1 / -1;
		display: grid;
		gap: 8px;
	}

	.about-links .about-card-heading {
		margin-bottom: 6px;
		text-align: center;
	}

	.about-links-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
	}

	.about-link {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		justify-content: center;
		gap: 8px;
		min-height: 78px;
		padding: 11px 12px;
		border: 1px solid #a77bd944;
		background: #7b4ca51a;
		color: #e8dff1;
		font-size: 12px;
		transition: background 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
	}

	.about-link span:last-child {
		color: #d0b1e7;
		text-align: left;
		overflow-wrap: anywhere;
	}

	.about-link:hover {
		border-color: #d1a9f8;
		background: #9b67c82e;
		box-shadow: 0 0 14px #9d4dff30;
	}

	.about-link:focus-visible {
		outline: 2px solid #e4c5ff;
		outline-offset: 3px;
	}

	footer {
		border-top: 1px solid #ffffff12;
		border-bottom: 0;
		gap: 20px;
		color: #aca2b6;
		font-size: 12px;
	}

	footer p {
		text-align: center;
	}

	@media (max-width: 768px) {
		.site-header,
		footer {
			padding: 18px 5%;
			gap: 12px;
		}

		.site-header {
			flex-wrap: wrap;
		}

		.header-controls {
			gap: 8px;
		}

		.brand {
			font-size: 14px;
			letter-spacing: 2px;
		}

		nav {
			gap: 8px;
			font-size: 12px;
		}

		.language-switch {
			gap: 2px;
			font-size: 11px;
		}

		.language-option {
			padding: 7px 3px;
		}

		.nav-section-link {
			min-height: 36px;
			padding: 6px 12px;
		}

		/* Evita que los marcos se salgan de la pantalla al hacer zoom */
		.focusable,
		.focusable.is-focused {
			transform: none;
		}

		.hero {
			min-height: auto;
			width: calc(100% - 24px);
			margin: 18px auto;
			padding: 42px 20px 64px;
		}

		/* Apila el avatar arriba del nombre para que nunca se desborde */
		.hero-identity {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: 16px;
			width: 100%;
		}

		.avatar {
			width: 96px;
		}

		h1 {
			margin: 8px 0 12px;
			font-size: clamp(40px, 13vw, 64px);
			letter-spacing: -2px;
		}

		.role {
			font-size: 11px;
			letter-spacing: 1.5px;
		}

		.hero-footer {
			flex-direction: column;
			gap: 8px;
			padding-top: 28px;
			font-size: 10px;
		}

		.projects,
